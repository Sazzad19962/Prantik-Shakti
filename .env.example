# কপি করে .env নামে রাখুন (লোকালে), অথবা Render ড্যাশবোর্ডে Environment হিসেবে যোগ করুন।
# .env ফাইল কখনো git-এ কমিট করবেন না।

# production হলে নিরাপদ কুকি (Secure), HSTS ও কঠোর যাচাই চালু হয়
NODE_ENV=development
PORT=3000

# MongoDB Atlas সংযোগ স্ট্রিং। খালি রাখলে data/ ফোল্ডারে লোকাল JSON ফাইলে ডেটা থাকবে।
# উদাহরণ: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/prantik_shakti?retryWrites=true&w=majority
MONGODB_URI=
# (ঐচ্ছিক) ডাটাবেসের নাম; না দিলে URI-এর নাম অথবা prantik_shakti
MONGODB_DB=

# প্রধান অ্যাডমিন (মালিক) — প্রথম চালুর সময় তৈরি হয়
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-password
# 1 দিলে পরের চালুতে মালিকের পাসওয়ার্ড ADMIN_PASSWORD অনুযায়ী রিসেট হবে (কাজ শেষে সরিয়ে দিন)
ADMIN_RESET_PASSWORD=

# কুকি স্বাক্ষরের গোপন কী — কমপক্ষে ৩২ অক্ষরের র‍্যান্ডম স্ট্রিং
# তৈরি করতে: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# (ঐচ্ছিক) লগইন সেশনের মেয়াদ (ঘণ্টা), ডিফল্ট 12
SESSION_TTL_HOURS=12
# (ঐচ্ছিক) লোকাল JSON ব্যাকএন্ডের ফোল্ডার, ডিফল্ট ./data
DATA_DIR=
